#!/bin/sh
# Sets up or updates a checkout for development on the host, as 37signals does with Fizzy: mise for
# Ruby and the tools (.mise.toml), Homebrew (Brewfile) or pacman for the system packages, and Postgres
# in a plain container unless one already listens on this checkout's port. Each git worktree gets its
# own Postgres on its own port (config/local_database.rb). Safe to run again at any time; bin/ci runs it.
#
#   bin/setup                 set up, then start bin/dev
#   bin/setup --skip-server   set up only
#   bin/setup --reset         also reset the development database
#
# This first part is shell. Until mise trusts this checkout's .mise.toml, its `ruby` shim refuses to run
# here at all, so a fresh checkout could not start a Ruby script. It installs mise when missing, trusts
# the config, installs the pinned Ruby and tools, then runs the Ruby below on that Ruby (`ruby -x` skips
# to the `#!ruby` line).
set -e
script="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
cd "$(dirname "$script")/.."

echo "== Installing mise, Ruby and tools =="
if ! command -v mise > /dev/null 2>&1; then
  if [ "$(uname -s)" = Darwin ] && command -v brew > /dev/null 2>&1; then
    brew install mise
  elif command -v pacman > /dev/null 2>&1; then
    sudo pacman -S --noconfirm --needed mise
  else
    echo "bin/setup needs mise: https://mise.jdx.dev" >&2
    exit 1
  fi
fi
mise trust --quiet "$PWD/.mise.toml"
mise install
exec mise exec -- ruby -x "$script" "$@"

#!ruby
require "fileutils"
require "socket"

APP_ROOT = File.expand_path("..", __dir__)
PORT_FILE = File.join(APP_ROOT, ".ermida-db-port")
POSTGRES_IMAGE = "postgres:18"
MAIN_PORT = 5432
FIRST_WORKTREE_PORT = 5433

def system!(*args)
  system(*args, exception: true)
end

def step(title)
  puts "\n== #{title} =="
end

def command?(name)
  system("command -v #{name} > /dev/null 2>&1")
end

def macos?
  RUBY_PLATFORM.include?("darwin")
end

def worktree?
  File.file?(File.join(APP_ROOT, ".git"))
end

def install_system_packages
  if macos?
    abort "bin/setup needs Homebrew on macOS: https://brew.sh" unless command?("brew")
    system("brew bundle check --quiet --file=Brewfile") || system!("brew bundle install --file=Brewfile")
    install_chrome
  elsif command?("pacman")
    packages = File.read(File.join(APP_ROOT, ".mise.toml")).scan(/"pacman:([\w.+-]+)"/).flatten
    system("pacman -Q #{packages.join(" ")} > /dev/null 2>&1") || system!("mise bootstrap packages apply --yes")
  else
    abort "bin/setup needs Homebrew (macOS) or pacman (Arch/Omarchy)"
  end
end

# System tests drive Chrome through Cuprite, which looks for it in /Applications. Homebrew refuses to
# install over a Chrome it did not install, so this only runs when there is none.
def install_chrome
  unless ["/Applications/Google Chrome.app", "/Applications/Chromium.app"].any? { |app| File.exist?(app) }
    system! "brew install --cask google-chrome"
  end
end

def install_gems
  system("bundle check > /dev/null") || system!("bundle install")

  # rails-hyperdrive's companion, kept out of the Gemfile so production and CI never install it
  unless `bundle plugin list 2>/dev/null`.include?("bundler-hyperdrive")
    system! "bundle", "plugin", "install", "bundler-hyperdrive", "--version", "0.2.0"
  end
end

# Mirrors config/local_database.rb, which reads the port this writes; keep the two in step.
def database_port
  if !ENV["ERMIDA_DB_PORT"].to_s.strip.empty?
    Integer(ENV["ERMIDA_DB_PORT"].strip)
  elsif File.exist?(PORT_FILE)
    Integer(File.read(PORT_FILE).strip)
  elsif worktree?
    port = free_worktree_port
    File.write(PORT_FILE, "#{port}\n")
    puts "This worktree's Postgres gets port #{port} (#{File.basename(PORT_FILE)})"
    port
  else
    MAIN_PORT
  end
end

def free_worktree_port
  taken = container_ports + other_worktree_ports
  (FIRST_WORKTREE_PORT..FIRST_WORKTREE_PORT + 100).find { |port| !taken.include?(port) && !listening?(port) } ||
    abort("No free port for this worktree's Postgres from #{FIRST_WORKTREE_PORT} up")
end

# Every checkout's container, stopped ones too: after Docker restarts they are all stopped and listen on nothing
def container_ports
  `docker ps -a --filter name=ermida-postgres --format '{{.Names}}' 2>/dev/null`.split.map { |name| published_port(name) }
end

# Covers a worktree whose bin/setup recorded its port but stopped before creating its container
def other_worktree_ports
  `git worktree list --porcelain`.scan(/^worktree (.+)$/).flatten
    .map { |path| File.join(path, File.basename(PORT_FILE)) }
    .select { |file| File.exist?(file) }
    .map { |file| File.read(file).to_i }
end

# Read from the container's configuration, which keeps the port while it is stopped (`docker ps` shows none then)
def published_port(name)
  `docker inspect --format '{{(index (index .HostConfig.PortBindings "5432/tcp") 0).HostPort}}' #{name} 2>/dev/null`.to_i
end

def listening?(port)
  Socket.tcp("127.0.0.1", port, connect_timeout: 1).close
  true
rescue SystemCallError, SocketError
  false
end

def container_name
  worktree? ? "ermida-postgres-#{File.basename(APP_ROOT)}" : "ermida-postgres"
end

# PGCONNECT_TIMEOUT: whatever listens on the port may not be a Postgres at all, and psql would wait on it forever
def psql(port, sql)
  `PGCONNECT_TIMEOUT=3 PGPASSWORD=postgres psql -h 127.0.0.1 -p #{port} -U postgres -d postgres -tAc "#{sql}" 2>/dev/null`.strip
end

# This checkout's own container comes first: whatever else listens on its port, after a Docker restart, may be
# another checkout's Postgres, with databases of the same names
def ensure_postgres(port)
  docker = system("docker info > /dev/null 2>&1")
  if docker && container?
    start_container(port)
  elsif listening?(port)
    check_postgres(port)
  elsif docker
    run_container(port)
  else
    abort "No Postgres on 127.0.0.1:#{port}, and Docker, which bin/setup starts one with, is not running"
  end
end

def container?
  !`docker ps -aq --filter name=^/#{container_name}$`.strip.empty?
end

def check_postgres(port)
  if psql(port, "select 1") != "1"
    abort <<~MESSAGE
      Something listens on 127.0.0.1:#{port}, but not a Postgres that accepts the postgres user with password
      postgres, which config/database.yml connects as. If it is a Postgres, create that role in it:

        psql -h 127.0.0.1 -p #{port} -d postgres -c "create role postgres with login superuser password 'postgres'"

      or stop that server, and bin/setup will start this checkout's own Postgres in a container.
    MESSAGE
  end

  unless psql(port, "show shared_preload_libraries").include?("pg_stat_statements")
    warn <<~MESSAGE
      The Postgres on port #{port} does not load pg_stat_statements, so /pghero shows no query stats.
      Add pg_stat_statements to shared_preload_libraries in its postgresql.conf and restart it.
    MESSAGE
  end
end

def run_container(port)
  system! "docker", "run", "--detach", "--name", container_name,
    "--env", "POSTGRES_PASSWORD=postgres",
    "--volume", "#{container_name}:/var/lib/postgresql", # Postgres 18 moved its data below this directory
    "--publish", "127.0.0.1:#{port}:5432",
    POSTGRES_IMAGE,
    "-c", "shared_preload_libraries=pg_stat_statements" # pghero's query stats; production loads it too
  wait_for_postgres(port)
end

def start_container(port)
  name = container_name
  published = published_port(name)
  if published != port
    abort "The #{name} container publishes port #{published}, not #{port}: point ERMIDA_DB_PORT or .ermida-db-port at #{published}, or remove the container (docker rm #{name}) to start a new one"
  end

  if `docker inspect --format '{{.State.Running}}' #{name}`.strip != "true"
    # Never start it into a taken port: after a failed start, Docker may start it again without the binding
    if listening?(port)
      abort "The #{name} container is stopped and something else listens on port #{port} (lsof -iTCP:#{port} -sTCP:LISTEN). Stop that server and run bin/setup again"
    end

    system! "docker", "start", name
  end
  wait_for_postgres(port)
end

def wait_for_postgres(port)
  name = container_name
  30.times do
    return if psql(port, "select 1") == "1"
    sleep 1
  end
  abort "Postgres in the #{name} container did not accept connections on port #{port} within 30 seconds"
end

FileUtils.chdir APP_ROOT do
  step "Installing system packages"
  install_system_packages

  step "Installing dependencies"
  install_gems
  # JavaScript packages for Vite, through the Bun that bundlebun ships
  system! "bin/bun", "install"

  step "Starting Postgres"
  port = database_port
  ensure_postgres(port)

  step "Preparing database"
  system! "bin/rails", "db:prepare"
  system! "bin/rails", "db:reset" if ARGV.include?("--reset")

  step "Installing git hooks"
  # --force writes the hooks even when a global core.hooksPath is set; such a global hooks directory
  # must chain to .git/hooks for these to run
  system! "prek", "install", "--force"

  step "Removing old logs and tempfiles"
  system! "bin/rails", "log:clear", "tmp:clear"

  unless ARGV.include?("--skip-server")
    step "Starting development server"
    STDOUT.flush # flush the output before exec(2) so that it displays
    exec "bin/dev"
  end
end
