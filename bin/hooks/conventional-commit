#!/bin/sh
# commit-msg hook (prek.toml): the subject must be a Conventional Commit,
# type(scope)!: description, e.g. "feat(auth): let people sign in with a code sent to their email".
# Git's own messages (merge, revert, fixup and friends) pass as they are.
subject=$(grep -v '^#' "$1" | sed '/^[[:space:]]*$/d' | head -n 1)

case "$subject" in
  "Merge "* | "Revert "* | "fixup! "* | "squash! "* | "amend! "*) exit 0 ;;
esac

if ! printf '%s\n' "$subject" | grep -Eq '^(build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test)(\([^()]+\))?!?: [^ ]'; then
  echo "commit-msg: \"$subject\" is not a Conventional Commit." >&2
  echo "commit-msg: write it as type(scope): description, e.g. \"feat(auth): let people sign in with a code sent to their email\"." >&2
  echo "commit-msg: types: build, chore, ci, docs, feat, fix, perf, refactor, revert, style, test." >&2
  exit 1
fi
