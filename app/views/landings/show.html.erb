<% content_for :title, @account.name %>

<h1><%= @account.name %></h1>

<% if allowed_to?(:share?, @account) %>
  <%= link_to t(".share"), share_path, class: "link" %>
<% end %>
<%= link_to t(".accounts"), session_menu_path(script_name: nil), class: "link" %>
<%= button_to t(".sign_out"), session_path(script_name: nil), method: :delete, class: "btn btn-ghost" %>
