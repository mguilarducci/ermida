<% content_for :title, t(".title") %>

<div class="card card-border max-w-xl">
  <div class="card-body" data-controller="clipboard" data-clipboard-copied-value="<%= t(".copied") %>">
    <h1 class="card-title"><%= t(".title") %></h1>
    <p><%= t(".intro", account: @account.name) %></p>

    <fieldset class="fieldset">
      <%= label_tag :join_link, t(".link"), class: "fieldset-legend" %>
      <div class="join w-full">
        <%= text_field_tag :join_link, join_url(code: @account.join_code), readonly: true,
              class: "input join-item w-full font-mono", data: {clipboard_target: "source"} %>
        <button type="button" class="btn btn-primary join-item" data-action="clipboard#copy"><%= t(".copy") %></button>
      </div>
      <p role="status" class="label text-success" data-clipboard-target="status"></p>
    </fieldset>
  </div>
</div>
