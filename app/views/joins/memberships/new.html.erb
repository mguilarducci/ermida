<% content_for :title, t(".title", account: @account.name) %>

<div class="card card-border max-w-md">
  <div class="card-body">
    <h1 class="card-title"><%= t(".title", account: @account.name) %></h1>
    <p><%= t(".joining_as", email_address: @join.identity.email_address) %></p>

    <%= form_with model: @join, url: join_membership_path(params[:code]) do |form| %>
      <% if @join.person_name_needed? %>
        <%= render FormField::Component.new(form:, attribute: :person_name) %>
      <% end %>

      <%= form.submit t(".submit", account: @account.name), class: "btn btn-primary" %>
    <% end %>
  </div>
</div>
