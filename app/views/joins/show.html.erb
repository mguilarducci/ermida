<% content_for :title, t(".title", account: @account.name) %>

<div class="card card-border max-w-md">
  <div class="card-body">
    <h1 class="card-title"><%= t(".title", account: @account.name) %></h1>
    <p><%= t(".intro") %></p>

    <%= form_with model: @join_request, url: join_path(params[:code]) do |form| %>
      <%= render FormField::Component.new(form:, attribute: :email_address, as: :email_field) %>

      <%= form.submit t(".submit"), class: "btn btn-primary" %>
    <% end %>
  </div>
</div>
